{
  "theme": "Office Communication",
  "vocabulary_focus": [
    {
      "concept": "Requesting an update/status",
      "expressions": {
        "en": "Could you give me an update?",
        "cn": "能给我一个更新吗？",
        "bm_formal": "Bolehkah anda kemas kini saya?",
        "bm_casual": "Boleh update saya?"
      }
    },
    {
      "concept": "Asking for clarification",
      "expressions": {
        "en": "Could you clarify that?",
        "cn": "你能澄清一下吗？",
        "bm_formal": "Bolehkah anda jelaskan perkara ini?",
        "bm_casual": "Boleh terang sikit?"
      }
    },
    {
      "concept": "Offering assistance",
      "expressions": {
        "en": "How can I help you?",
        "cn": "我能怎样帮助你？",
        "bm_formal": "Bagaimana saya boleh membantu anda?",
        "bm_casual": "Macam mana saya boleh tolong?"
      }
    },
    {
      "concept": "Suggesting a meeting/discussion",
      "expressions": {
        "en": "Shall we discuss this?",
        "cn": "我们讨论一下吧？",
        "bm_formal": "Haruskah kita bincangkan perkara ini?",
        "bm_casual": "Jom bincang?"
      }
    },
    {
      "concept": "Confirming understanding/agreement",
      "expressions": {
        "en": "Understood. / Agreed.",
        "cn": "明白了。 / 同意。",
        "bm_formal": "Faham. / Bersetuju.",
        "bm_casual": "Faham. / Setuju."
      }
    },
    {
      "concept": "Apologizing for a delay/mistake",
      "expressions": {
        "en": "Apologies for the delay.",
        "cn": "抱歉耽误了。",
        "bm_formal": "Mohon maaf atas kelewatan.",
        "bm_casual": "Sorry lambat."
      }
    }
  ],
