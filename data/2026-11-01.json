      "key_phrases": [
        "Apa khabar? Boleh saya bantu?",
        "Di manakah Jabatan IT?",
        "Terima kasih banyak!"
      ]
    },
    "life": {
      "scenario": "You're at a busy hawker centre. You accidentally bump into someone and then need to ask for the restroom.",
      "key_phrases": [
        "Maafkan saya!",
        "Tandas kat mana, ya?",
        "Mekasih!"
      ]
    },
    "tech": {
      "scenario": "Your internet is down. You call your internet service provider's support line and need to explain your issue.",
      "key_phrases": [
        "Apa cerita, internet saya tak berfungsi.",
