{
  "theme": "Office Communication",
  "vocabulary_focus": [
    {
      "concept": "Asking for clarification/repetition",
      "expressions": {
        "en": "Could you elaborate/repeat that?",
        "cn": "您能详细说明/再说一遍吗？",
        "bm_formal": "Bolehkah anda huraikan/ulangi?",
        "bm_casual": "Boleh cerita lebih sikit/ulang balik?"
      }
    },
    {
      "concept": "Confirming understanding",
      "expressions": {
        "en": "Am I understanding this correctly?",
        "cn": "我这样理解对吗？",
        "bm_formal": "Adakah pemahaman saya ini tepat?",
        "bm_casual": "Betul ke saya faham ni?"
      }
    },
    {
      "concept": "Suggesting a meeting/discussion",
      "expressions": {
        "en": "Let's schedule a discussion/meeting.",
        "cn": "我们约个讨论/会议吧。",
        "bm_formal": "Mari kita jadualkan perbincangan/mesyuarat.",
        "bm_casual": "Jomlah kita set bincang/meeting."
      }
    },
    {
      "concept": "Requesting an update/status",
      "expressions": {
        "en": "Could you provide an update?",
        "cn": "您能提供一下最新进展吗？",
        "bm_formal": "Bolehkah anda berikan kemas kini?",
        "bm_casual": "Boleh update tak?"
      }
    },
    {
      "concept": "Politely expressing disagreement",
      "expressions": {
        "en": "I see your point, but",
        "cn": "我明白您的观点，但是",
        "bm_formal": "Saya faham maksud anda, namun",
        "bm_casual": "Saya faham, tapi"
      }
    },
    {
      "concept": "Offering assistance",
      "expressions": {
        "en": "How can I assist you?",
        "cn": "我能如何协助您？",
        "bm_formal": "Bagaimana saya boleh membantu anda?",
        "bm_casual": "Apa yang saya boleh tolong?"
      }
    }
  ],
