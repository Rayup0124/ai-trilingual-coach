        "bm_formal": "Boleh tolong saya sebentar?",
        "bm_casual": "Tolong kejap?"
      }
    },
    {
      "concept": "Confirming understanding (positive)",
      "expressions": {
        "en": "I understand / Got it.",
        "cn": "我明白了。",
        "bm_formal": "Saya faham.",
        "bm_casual": "Ngam!"
      }
    },
    {
      "concept": "Confirming information (question)",
      "expressions": {
        "en": "Is that correct? / Right?",
        "cn": "对吗？",
