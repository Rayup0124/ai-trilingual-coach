        "bm_casual": "Betul tak?"
      }
    },
    {
      "concept": "Apologizing for a minor inconvenience",
      "expressions": {
        "en": "Sorry about that.",
        "cn": "抱歉。",
        "bm_formal": "Maafkan saya.",
        "bm_casual": "Sorry lah."
      }
    },
    {
      "concept": "Expressing gratitude",
      "expressions": {
        "en": "Thank you so much.",
        "cn": "非常感谢。",
        "bm_formal": "Terima kasih banyak-banyak.",
        "bm_casual": "TQ"
      }
    },
    {
      "concept": "Requesting repetition/clarification",
      "expressions": {
        "en": "Could you repeat that?",
        "cn": "你能再说一遍吗？",
        "bm_formal": "Boleh ulang semula?",
        "bm_casual": "Ulang balik?"
      }
    }
  ],
